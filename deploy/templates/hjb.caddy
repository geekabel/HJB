# Site of the residence app, written by deploy/deploy.sh (card T38).
# Docs: https://caddyserver.com/docs/caddyfile
# HTTPS is automatic: Caddy gets and renews the certificate from Let's
# Encrypt (ZeroSSL if Let's Encrypt fails), and redirects HTTP to HTTPS.
# https://caddyserver.com/docs/automatic-https

@DOMAIN@ {
	# The ACME account e-mail: the CA writes there if a certificate has trouble.
	tls @ACME_EMAIL@

	encode zstd gzip

	# 3 photos of 10 MB at most per report, plus the form (card T30).
	# Above it, Caddy answers 413 before Django reads anything.
	request_body {
		max_size 35MB
	}

	header {
		-Server
	}

	# Static files, straight from disk (collectstatic). Django serves no
	# media: report photos go through a view that checks who asks.
	handle_path /static/* {
		root * @STATIC_ROOT@
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# Everything else to Gunicorn. Caddy sets X-Forwarded-For (the client
	# address, read by audit.service.client_ip) and X-Forwarded-Proto, and
	# ignores the values a client sends: no proxy is trusted before it.
	# https://caddyserver.com/docs/caddyfile/directives/reverse_proxy
	handle {
		reverse_proxy 127.0.0.1:@APP_PORT@
	}

	# Access log, rotated. The secret in the address of the OVH delivery
	# receipts (card T24) never reaches the log.
	# https://caddyserver.com/docs/caddyfile/directives/log
	log {
		output file /var/log/caddy/hjb-access.log {
			roll_size 10MiB
			roll_keep 10
		}
		format filter {
			request>uri regexp ^/sms/ovh/[^/]+/ /sms/ovh/REDACTED/
		}
	}
}
