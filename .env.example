# Production environment variables. Copy to .env (never committed)
# and fill in the values on the server.

DJANGO_SETTINGS_MODULE=config.settings.prod

# Required. Generate with:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g()+g())"
DJANGO_SECRET_KEY=
# Old keys during a rotation, separated by commas.
DJANGO_SECRET_KEY_FALLBACKS=

# Domain names served, separated by commas.
DJANGO_ALLOWED_HOSTS=

# Passkeys: the site domain, without https:// (e.g. residence.example.fr),
# then its origins separated by commas (e.g. https://residence.example.fr).
# Changing the domain later makes all passkeys unusable.
DJANGO_WEBAUTHN_RP_ID=
DJANGO_WEBAUTHN_ORIGINS=

# Address of the Django admin, without a leading "/" (e.g. gestion-7f3k).
# Choose an address that is hard to guess: "admin" is reported by check --deploy.
DJANGO_ADMIN_URL=

# Wifi passwords: Fernet keys, separated by commas, the newest first (T15).
# Create one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy outside the server: without it, the stored passwords are lost.
DJANGO_WIFI_KEYS=

# Web Push notifications (T19): private VAPID key, created with
#   python manage.py vapid_key
# and a contact for the push services (mailto: or https://).
DJANGO_VAPID_PRIVATE_KEY=
DJANGO_VAPID_CONTACT=

# Database: PostgreSQL if POSTGRES_DB is filled in, else SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
DJANGO_SQLITE_PATH=

# E-mail (SMTP).
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=

# HTTPS.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
# Set to 1 only behind a proxy that overwrites X-Forwarded-Proto.
DJANGO_BEHIND_PROXY=0

# SMS: ovh (production), smsgate (tests with an Android phone),
# console (shows the SMS in the logs: never in production), disabled.
# Empty: no SMS is sent. See sms/providers/.
DJANGO_SMS_PROVIDER=
# SMSGate: phone URL (local mode, http://IP:8080) or https://api.sms-gate.app.
# Token (cloud) or username and password shown in the app.
SMSGATE_URL=
SMSGATE_TOKEN=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_SIM=
# OVHcloud: keys created on https://auth.eu.ovhcloud.com/api/createToken
# with the rights GET /sms/, GET /sms/*/jobs and POST /sms/*/jobs
# (with OVH_SMS_USER: POST /sms/*/users/*/jobs too).
OVH_ENDPOINT=ovh-eu
OVH_SMS_SERVICE=
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# Sender declared at OVHcloud. Empty: short number, which allows replies.
OVH_SMS_SENDER=
# Delivery receipts of OVHcloud (T24): the SMS API user whose callback is set
# (the SMS are sent through it), and a long random secret (32 characters or
# more: letters, digits, - and _, for example
# python -c "import secrets; print(secrets.token_urlsafe(32))").
# In the OVHcloud manager, set the callback of that user to
# https://<site>/sms/ovh/<secret>/ (see the README). Empty: no receipts.
OVH_SMS_USER=
DJANGO_SMS_RECEIPT_SECRET=

# Address of the site in the SMS links (T22), without a final slash. Empty:
# the first address of DJANGO_WEBAUTHN_ORIGINS.
DJANGO_SITE_URL=
