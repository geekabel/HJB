# Variables d'environnement de production. Copier en .env (jamais commité)
# et remplir les valeurs sur le serveur.

DJANGO_SETTINGS_MODULE=config.settings.prod

# Obligatoire. Générer avec :
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g()+g())"
DJANGO_SECRET_KEY=
# Anciennes clés pendant une rotation, séparées par des virgules.
DJANGO_SECRET_KEY_FALLBACKS=

# Noms de domaine servis, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=

# Clés d'accès (passkeys) : le domaine du site, sans https:// (ex. residence.example.fr),
# puis ses origines séparées par des virgules (ex. https://residence.example.fr).
# Changer de domaine plus tard rend toutes les clés d'accès inutilisables.
DJANGO_WEBAUTHN_RP_ID=
DJANGO_WEBAUTHN_ORIGINES=

# Base de données : PostgreSQL si POSTGRES_DB est rempli, sinon SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
DJANGO_SQLITE_PATH=

# E-mail (SMTP).
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=

# HTTPS.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
# Mettre 1 seulement derrière un proxy qui écrase X-Forwarded-Proto.
DJANGO_BEHIND_PROXY=0

# SMS : ovh (production), smsgate (essais avec un téléphone Android),
# console (affiche les SMS dans les journaux : jamais en production).
# Vide : aucun SMS ne part. Voir sms/fournisseurs/.
DJANGO_SMS_FOURNISSEUR=
# SMSGate : URL du téléphone (mode local, http://IP:8080) ou https://api.sms-gate.app.
# Jeton (nuage) ou identifiant et mot de passe affichés dans l'application.
SMSGATE_URL=
SMSGATE_JETON=
SMSGATE_IDENTIFIANT=
SMSGATE_MOT_DE_PASSE=
SMSGATE_SIM=
# OVHcloud : clés créées sur https://auth.eu.ovhcloud.com/api/createToken
# avec les droits GET /sms/, GET /sms/*/jobs et POST /sms/*/jobs.
OVH_ENDPOINT=ovh-eu
OVH_SMS_SERVICE=
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# Expéditeur déclaré chez OVHcloud. Vide : numéro court, qui permet les réponses.
OVH_SMS_EXPEDITEUR=
